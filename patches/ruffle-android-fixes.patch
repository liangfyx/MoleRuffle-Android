+}
+
+/// MoleRuffle:本地资源缓存的落盘路径。
+///
+/// 只缓存**游戏域下的静态资源**(swf/xml/mp3/图片)—— 这些才是"每次进场景都要重下"
+/// 的大头;不缓存 txt(配置/IP 会变)和统计脚本(每次都要上报)。
+/// 缓存目录由环境变量 `MOLE_CACHE_DIR` 给出(安卓端启动时指向应用私有目录);
+/// 没设置这个变量就完全不启用缓存,行为与官方一致。
+fn mole_cache_file(url: &Url) -> Option<std::path::PathBuf> {
+    use std::collections::hash_map::DefaultHasher;
+    use std::hash::{Hash, Hasher};
+
+    let dir = std::env::var("MOLE_CACHE_DIR").ok()?;
+    if dir.is_empty() {
+        return None;
+    }
+    let host = url.host_str().unwrap_or_default();
+    if !host.ends_with("mole.61player.com") {
+        return None;
+    }
+    let path = url.path();
+    let lower = path.to_ascii_lowercase();
+    let cacheable = [
+        ".swf", ".xml", ".mp3", ".png", ".jpg", ".jpeg", ".gif", ".zip", ".swz",
+    ]
+    .iter()
+    .any(|ext| lower.ends_with(ext));
+    if !cacheable {
+        return None;
+    }
+    let mut h = DefaultHasher::new();
+    h.write(url.as_str().as_bytes());
+    let hash = h.finish();
+    // 文件名取路径里的安全字符(便于人工辨认)+ 完整 URL 的哈希(防重名/防碰撞)。
+    let stem: String = path
+        .chars()
+        .filter(|c| c.is_ascii_alphanumeric() || matches!(c, '.' | '-' | '_'))
+        .take(60)
+        .collect();
+    Some(
+        std::path::PathBuf::from(dir)
+            .join(format!("{stem}.{hash:x}")),
+    )
+}
+
+/// MoleRuffle:缓存上限(字节),由安卓端通过 JNI 设置(悬浮球菜单里可改 MB 数)。
+static CACHE_MAX_BYTES: std::sync::atomic::AtomicU64 =
+    std::sync::atomic::AtomicU64::new(512 * 1024 * 1024);
+/// 自上次容量检查以来累计写入的字节(超过阈值才去遍历目录,省掉每次 stat 全目录)。
+static CACHE_WRITTEN: std::sync::atomic::AtomicU64 = std::sync::atomic::AtomicU64::new(0);
+
+/// 设置缓存上限(MB)。
+pub fn mole_cache_set_limit_mb(mb: u64) {
+    CACHE_MAX_BYTES.store(
+        mb.saturating_mul(1024 * 1024),
+        std::sync::atomic::Ordering::Relaxed,
+    );
+}
+
+/// 按"最久未使用"淘汰,直到总大小 <= 上限。返回释放的字节数。
+pub fn mole_cache_trim(max_bytes: Option<u64>) -> u64 {
+    let dir = match std::env::var("MOLE_CACHE_DIR") {
+        Ok(d) if !d.is_empty() => std::path::PathBuf::from(d),
+        _ => return 0,
+    };
+    let max = max_bytes
+        .unwrap_or_else(|| CACHE_MAX_BYTES.load(std::sync::atomic::Ordering::Relaxed));
+    let Ok(entries) = std::fs::read_dir(&dir) else {
+        return 0;
+    };
+    let mut files: Vec<(std::time::SystemTime, std::path::PathBuf, u64)> = Vec::new();
+    let mut total = 0u64;
+    for e in entries.flatten() {
+        let p = e.path();
+        // 元信息文件跟着 body 一起删,不单独计入总量。
+        if p.extension().and_then(|s| s.to_str()) == Some("meta") {
+            continue;
+        }
+        if let Ok(m) = e.metadata() {
+            if m.is_file() {
+                total += m.len();
+                files.push((m.modified().unwrap_or(std::time::UNIX_EPOCH), p, m.len()));
+            }
+        }
+    }
+    if total <= max {
+        return 0;
+    }
+    files.sort_by_key(|(t, _, _)| *t);
+    let mut freed = 0u64;
+    for (_, p, len) in files {
+        if total <= max {
+            break;
+        }
+        let meta = mole_cache_meta_path(&p);
+        let _ = std::fs::remove_file(&meta);
+        if std::fs::remove_file(&p).is_ok() {
+            freed += len;
+            total = total.saturating_sub(len);
+        }
+    }
+    tracing::warn!(
+        "MOLEFETCH 缓存超限,已按最久未用淘汰 {} KB(剩余 {} KB)",
+        freed / 1024,
+        total / 1024
+    );
+    freed
+}
+
+/// 写缓存后记账;累计写入超过 16 MB 才做一次容量检查(避免每次写都遍历目录)。
+fn mole_cache_account(len: u64) {
+    let written =
+        CACHE_WRITTEN.fetch_add(len, std::sync::atomic::Ordering::Relaxed) + len;
+    if written >= 16 * 1024 * 1024 {
+        CACHE_WRITTEN.store(0, std::sync::atomic::Ordering::Relaxed);
+        mole_cache_trim(None);
+    }
+}
+
+/// 缓存元信息文件:第 1 行 ETag、第 2 行 Last-Modified、第 3 行写入时间(unix 秒)。
+fn mole_cache_meta_path(p: &std::path::Path) -> std::path::PathBuf {
+    let mut s = p.as_os_str().to_os_string();
+    s.push(".meta");
+    std::path::PathBuf::from(s)
+}
+
+fn mole_now_secs() -> u64 {
+    std::time::SystemTime::now()
+        .duration_since(std::time::UNIX_EPOCH)
+        .map(|d| d.as_secs())
+        .unwrap_or(0)
+}
+
+/// 新鲜期(秒):缓存写入后这段时间内直接命中、完全不联网。
+///   过期后才带 ETag 去问服务器 —— 既快,又能在资源更新后自动刷新。
+fn mole_cache_ttl() -> u64 {
+    std::env::var("MOLE_CACHE_TTL")
+        .ok()
+        .and_then(|v| v.trim().parse::<u64>().ok())
+        .unwrap_or(6 * 3600)
+}
+
+fn mole_cache_fresh(meta: &std::path::Path, ttl: u64) -> bool {
+    if ttl == 0 {
+        return false;
+    }
+    let Ok(text) = std::fs::read_to_string(meta) else {
+        return false;
+    };
+    let saved = text
+        .lines()
+        .nth(2)
+        .and_then(|l| l.trim().parse::<u64>().ok())
+        .unwrap_or(0);
+    saved > 0 && mole_now_secs().saturating_sub(saved) < ttl
+}
+
+fn mole_cache_validators(meta: &std::path::Path) -> (Option<String>, Option<String>) {
+    let Ok(text) = std::fs::read_to_string(meta) else {
+        return (None, None);
+    };
+    let mut it = text.lines();
+    let etag = it.next().map(|s| s.trim().to_string()).filter(|s| !s.is_empty());
+    let lm = it.next().map(|s| s.trim().to_string()).filter(|s| !s.is_empty());
+    (etag, lm)
+}
+
+/// 命中缓存时刷新"最后使用时间"(LRU),严格按最久未用淘汰。
+fn mole_cache_touch(p: &std::path::Path) {
+    if let Ok(f) = std::fs::OpenOptions::new().write(true).open(p) {
+        let _ = f.set_modified(std::time::SystemTime::now());
+    }
+}
+
+/// 写 body + 元信息(ETag / Last-Modified / 写入时间)。
+fn mole_cache_store(
+    path: &std::path::Path,
+    bytes: &[u8],
+    etag: Option<&str>,
+    last_modified: Option<&str>,
+) {
+    if std::fs::write(path, bytes).is_ok() {
+        let meta = mole_cache_meta_path(path);
+        let content = format!(
+            "{}\n{}\n{}\n",
+            etag.unwrap_or(""),
+            last_modified.unwrap_or(""),
+            mole_now_secs()
+        );
+        let _ = std::fs::write(meta, content);
+        mole_cache_account(bytes.len() as u64);
+    }
+}
