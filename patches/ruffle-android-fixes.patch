+static INFLIGHT: Mutex<Option<HashSet<String>>> = Mutex::new(None);
+
+fn mole_inflight_contains(key: &str) -> bool {
+    let g = INFLIGHT.lock().unwrap();
+    g.as_ref().map_or(false, |s| s.contains(key))
+}
+
+fn mole_inflight_add(key: &str) {
+    let mut g = INFLIGHT.lock().unwrap();
+    g.get_or_insert_with(HashSet::new).insert(key.to_string());
+}
+
+fn mole_inflight_remove(key: &str) {
+    let mut g = INFLIGHT.lock().unwrap();
+    if let Some(s) = g.as_mut() {
+        s.remove(key);
+    }
+}
+
+/// 并发去重的 key —— 只对"会进缓存的静态资源"生效(与缓存文件名同规则)。
+fn mole_dedupe_key(url: &Url) -> Option<String> {
+    mole_cache_file(url).map(|p| p.to_string_lossy().to_string())
+}
+
+/// 命中缓存时的响应。
+fn mole_cached_response(url: &str, bytes: Vec<u8>) -> Box<dyn SuccessResponse> {
+    Box::new(Response {
+        url: url.to_string(),
+        response_body: ResponseBody::File(Ok(bytes)),
