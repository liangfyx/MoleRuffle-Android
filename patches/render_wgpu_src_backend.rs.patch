diff --git a/render/wgpu/src/backend.rs b/render/wgpu/src/backend.rs
index 5dcf43c0a..c16150fdb 100644
--- a/render/wgpu/src/backend.rs
+++ b/render/wgpu/src/backend.rs
@@ -79,6 +79,8 @@ pub struct WgpuRenderBackend<T: RenderTarget> {
     viewport_scale_factor: f64,
     texture_pool: TexturePool,
     offscreen_texture_pool: TexturePool,
+    // ★ MoleRuffle:防内存泄漏 —— 主 texture_pool 周期性重置用的帧计数(见 submit_frame)。
+    frames_since_pool_reset: u32,
     pub(crate) offscreen_buffer_pool: Arc<BufferPool<wgpu::Buffer, BufferDimensions>>,
     dynamic_transforms: DynamicTransforms,
     active_frame: ActiveFrame,
@@ -276,6 +278,7 @@ impl<T: RenderTarget> WgpuRenderBackend<T> {
             viewport_scale_factor: 1.0,
             texture_pool: TexturePool::new(),
             offscreen_texture_pool: TexturePool::new(),
+            frames_since_pool_reset: 0,
             offscreen_buffer_pool: Arc::new(offscreen_buffer_pool),
             dynamic_transforms: transforms,
             active_frame,
@@ -666,8 +669,26 @@ impl<T: RenderTarget + 'static> RenderBackend for WgpuRenderBackend<T> {
             .resolve_queries(&mut self.active_frame.command_encoder);
         self.active_frame.staging_belt.finish();
 
-        self.active_frame
+        let submission = self
+            .active_frame
             .submit_for_target(&self.descriptors, &self.target, frame_output);
+        // MoleRuffle:等 GPU 真正执行完这一帧,再回收下面的 offscreen 纹理池 / staging ——
+        //   否则进/出餐厅等场景切换时,旧场景纹理在 GPU 还在读的瞬间被回收/复用 →
+        //   Adreno 驱动 memset 到坏地址直接崩(日志13 GL / 日志11 Vulkan 同源症状)。
+        //   24FPS 游戏每帧 GPU 本就吃不满,poll(Wait) 排空带来的串行开销可忽略。
+        let _ = self.descriptors.device.poll(wgpu::PollType::Wait {
+            submission_index: Some(submission),
+            timeout: None,
+        });
+        // ★ MoleRuffle:防内存泄漏 —— 主 texture_pool 按 TextureKey 累积(PoolEntry 只是把纹理
+        //   还回池里、从不真正释放),长时间游玩内存一直涨 → 最终 scudo 分配器崩/OMM(群友反馈
+        //   的 ruffle 通病)。每 60 帧重置一次:既保留一段时间的复用,又把内存控制住。
+        //   offscreen 池本来就每帧重置(见下一行)。
+        self.frames_since_pool_reset += 1;
+        if self.frames_since_pool_reset >= 60 {
+            self.frames_since_pool_reset = 0;
+            self.texture_pool = TexturePool::new();
+        }
         self.offscreen_texture_pool = TexturePool::new();
         self.profiler
             .end_frame()
